{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authzloom.dev/schema/scenario.v1.json",
  "title": "AuthzLoom Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "sessions",
    "objects",
    "operation"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "program",
        "asset",
        "allowed_hosts"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "aggression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "rate_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allow_irreversible": {
          "type": "boolean"
        },
        "allowed_ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "allowed_transports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "direct",
              "burp",
              "cdp"
            ]
          }
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "isolated_cases": {
          "type": "boolean"
        }
      }
    },
    "sessions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/session"
      }
    },
    "objects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object"
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "readback": {
          "$ref": "#/$defs/request"
        },
        "readback_assertion": {
          "$ref": "#/$defs/assertion"
        },
        "cleanup": {
          "$ref": "#/$defs/request"
        },
        "cleanup_assertion": {
          "$ref": "#/$defs/assertion"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "irreversible": {
      "type": "boolean"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "isolated_cases": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": true,
        "transport": {
          "enum": [
            "direct",
            "burp",
            "cdp"
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "equals": true,
        "segments": {
          "type": "array"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "identity_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "assertion": {
              "$ref": "#/$defs/assertion"
            }
          }
        },
        "capture_handle": {
          "type": "string",
          "pattern": "^cap_[A-Za-z0-9_-]{8,64}$"
        },
        "endpoint": {
          "type": "string"
        },
        "page_host": {
          "type": "string"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "session",
        "object_owner"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "object_owner": {
          "type": "string"
        },
        "isolated": {
          "type": "boolean"
        }
      }
    }
  }
}
